# ─────────────────────────────────────────
# Supabase
# https://app.supabase.com/project/_/settings/api
# ─────────────────────────────────────────
# 프로젝트의 API URL (브라우저/서버 공통 사용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon (public) 키 - 브라우저에서 사용 가능
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key - 절대 클라이언트에 노출되면 안 됩니다. 서버 전용.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────
# AI APIs
# ─────────────────────────────────────────
# Anthropic Claude API
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-key

# Google Gemini API
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-key

# ─────────────────────────────────────────
# Admin
# ─────────────────────────────────────────
ADMIN_SECRET=change-me-before-use

# ─────────────────────────────────────────
# 도매꾹 소싱 API
# ─────────────────────────────────────────
DOMEGGOOK_API_KEY=your-domeggook-api-key
DOMEGGOOK_API_BASE_URL=https://domeggook.com/ssl/api/

# ─────────────────────────────────────────
# Cron 스케줄러 인증
# ─────────────────────────────────────────
CRON_SECRET=your-cron-secret

# ─────────────────────────────────────────
# 토스쇼핑 Open API
# https://shopping-docs.toss.im/dev/api-2/auth
# ─────────────────────────────────────────
TOSS_SHOPPING_ACCESS_TOKEN=your-toss-shopping-access-token

# ─────────────────────────────────────────
# Render PostgreSQL (소싱 데이터 전용)
# ─────────────────────────────────────────
SOURCING_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─────────────────────────────────────────
# 공공데이터포털 — KIPRIS 상표 검색 API
# https://www.data.go.kr → "특허정보 검색서비스" 활용 신청
# 마이페이지 → 인증키 발급 → 일반 인증키(Encoding) 복사
# ─────────────────────────────────────────
KIPRIS_API_KEY=your-kipris-api-key

# ─────────────────────────────────────────
# YouTube Data API v3
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 1) 프로젝트에서 YouTube Data API v3 활성화
# 2) 사용자 인증 정보 → API 키 만들기
# 3) 보안: HTTP 리퍼러/IP 제한 + API 제한(YouTube Data API v3) 설정
# ─────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-data-api-key

# Next.js Route Handler 바디 크기 제한 (기본 4MB → 10MB으로 상향, 섹션 이미지 업로드 413 방지)
NEXT_BODY_SIZE_LIMIT=10485760


# CLOVA OCR (상품 이미지 텍스트 추출)
NAVER_CLOVA_OCR_API_KEY_ID=
NAVER_CLOVA_OCR_API_KEY=

# CLOVA Speech (리뷰 음성 입력)
# NCP 콘솔에서 같은 Application에 두 서비스 등록 시 API_KEY_ID 동일하게 사용 가능
NAVER_CLOVA_SPEECH_API_KEY_ID=
NAVER_CLOVA_SPEECH_API_KEY=

# 1688 스펙 가져오기 활성화 (로컬 전용, puppeteer-core 필요)
# ENABLE_1688_SCRAPE=1
